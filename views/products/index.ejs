<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Products</title>
</head>
<body>
    <%- include('../navbar') %>
    <h1>Products</h1>

    <% products.forEach((oneProduct)=>{ %>
        <div class="product-item">
            <h2><%= oneProduct.name %></h2>
            <p>Category: <%= oneProduct.category %></p>
            <p>Price: $<%= oneProduct.price %></p>
            <p>Size: <%= oneProduct.size %></p>
            <p>Color: <%= oneProduct.color %></p>
            <p>In Stock: <%= oneProduct.inStock ? "Yes" : "No" %></p>
            <img src="../images/<%= oneProduct.image %>" alt="<%= oneProduct.name %>">

            <div class="options-bar">
            <a href="/basket">View Basket</a>            
            <form action="/basket/add/<%= oneProduct._id %>" method="POST" style="display:inline;">
                <button type="submit">Add to Cart</button>
            </form>
            <% if(user.isAdmin) { %>
            <a href="/products/<%= oneProduct._id %>">View Details</a>
            <a href="/products/new">Add New Product</a>
            <% } %>
            </div>
        </div>
        <hr/> 

    <% })%>
            <!-- <% if(user.isAdmin) { %>
            <a href="/products/new">Add New Product</a>
            <% } %> -->
</body>
</html>